# Application Environment
NODE_ENV=development
PORT=3000

# Database Connection (PostgreSQL)
DATABASE_URL=postgres://gdgoc:gdgoc_password@localhost:5432/gdgoc_db

# JWT Configuration
JWT_SECRET=super_secret_jwt_key_gdgoc_unsri_change_in_production_min_32_chars
JWT_EXPIRES_IN=1h

# Security & CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=5

# Seed Passwords (Development / Reviewer defaults, minimal 12 karakter)
SEED_SUPERADMIN_PASSWORD=SuperAdminPassword123!
SEED_ADMIN_PASSWORD=AdminPassword123!
SEED_EXECUTIVE_PASSWORD=ExecutivePassword123!
SEED_PO1_PASSWORD=ProductOwner1Password123!
SEED_PO2_PASSWORD=ProductOwner2Password123!

